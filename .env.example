# KINTRA Environment Variables
# Copy to .env.local for local development

# ----------------------------------------------------
# AI Intelligence Model
# ----------------------------------------------------
# Google Gemini API Key (optional - system falls back to high-fidelity deterministic fixtures if unset)
GEMINI_API_KEY=
# Alternative fallback key identifier for Google AI Studio
GOOGLE_API_KEY=
# Gemini model identifier (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------
# Live Web Research Search Providers
# ----------------------------------------------------
# Tavily Search API key for real-time market landscape research
TAVILY_API_KEY=
# SerpAPI search key fallback for competitor indexing
SERP_API_KEY=

# ----------------------------------------------------
# Runtime Execution Mode
# ----------------------------------------------------
# Set to "true" to force deterministic fixture mode for zero-latency testing & offline demos
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
